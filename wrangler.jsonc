// Cloudflare Workers (static assets) deploy config.
// - "name" MUST equal the Worker's name in the Cloudflare dashboard. Rename it
//   per client (e.g. "acmevet"); a mismatch makes Cloudflare deploy a separate
//   Worker, and the connected one keeps serving its "Hello World" stub.
// - Workers Builds (Git-connected): build command `npm run build`, deploy
//   command `npx wrangler deploy`. Every push to main rebuilds and deploys.
// - Pre-launch preview: set the build variable SITE_URL to the workers.dev
//   address (see astro.config.mjs); remove it at launch.
{
  "name": "skeleton",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
