---
// Generic forms hub — no dedicated "forms list" collection exists in
// Skeleton's content model, so this ships as a single-form placeholder
// page (New Patient Form) an AI/dev extends with more embeds per client
// as needed. See Skeleton-Build-Spec.md §8.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeaderBanner from "../components/PageHeaderBanner.astro";
import GravityFormEmbed from "../components/GravityFormEmbed.astro";
---

<BaseLayout title="Online Forms" description="New patient and other online forms.">
  <PageHeaderBanner heading="Online Forms" />
  <div class="page-section">
    <GravityFormEmbed formId="new-patient" context="general-info" heading="New Patient Form" />
  </div>
</BaseLayout>

<style>
  .page-section { max-width: 40rem; margin-inline: auto; padding: var(--space-xl) var(--space-md); }
</style>
