---
// Homepage hero. Rebuilt 2026-09-08 to a full-bleed background-image
// section (was a two-column flex layout) so the sitewide sticky header can
// render transparent + white text over it, matching real visual ref
// ref1.jpg: dark overlay over a full-bleed photo, min 60vh, centered white
// text. Same overlay pattern as PageHeaderBanner (image optional — renders
// on a solid dark background before real client imagery exists). See
// Skeleton-Build-Spec.md §6.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  eyebrow?: string;
  heading: string;
  subheading?: string;
  ctaText?: string;
  ctaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { eyebrow, heading, subheading, ctaText, ctaHref, secondaryCtaText, secondaryCtaHref, image, imageAlt = "" } = Astro.props;
---

<section class="hero">
  {image && <Image src={image} alt={imageAlt} class="hero__image" />}
  <div class="hero__overlay"></div>
  <div class="hero__content">
    {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
    <h1 class="hero__heading">{heading}</h1>
    {subheading && <p class="hero__subheading">{subheading}</p>}
    {(ctaText || secondaryCtaText) && (
      <div class="hero__actions">
        {ctaText && ctaHref && <a class="hero__cta hero__cta--primary" href={ctaHref}>{ctaText}</a>}
        {secondaryCtaText && secondaryCtaHref && <a class="hero__cta hero__cta--secondary" href={secondaryCtaHref}>{secondaryCtaText}</a>}
      </div>
    )}
  </div>
</section>

<style>
  /* padding-block-start includes --header-height (2026-09-08) — same
     full-bleed-behind-the-fixed-header technique as PageHeaderBanner. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 60vh;
    overflow: hidden;
    text-align: center;
    padding: var(--space-xl) var(--space-md);
    padding-block-start: calc(var(--header-height) + var(--space-xl));
    background: var(--main-dark);
    color: var(--on-main);
  }
  .hero__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .hero__overlay { position: absolute; inset: 0; background: var(--overlay-color); z-index: 1; }
  .hero__content { position: relative; z-index: 2; max-width: 42rem; }
  .hero__eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--font-size-sm); margin: 0 0 var(--space-xs); opacity: 0.9; }
  .hero__heading { margin: 0 0 var(--space-sm); color: inherit; font-size: var(--font-size-4xl); }
  .hero__subheading { margin: 0 auto var(--space-lg); font-size: var(--font-size-lg); opacity: 0.9; max-width: 36rem; }
  .hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-sm); }
  .hero__cta { display: inline-block; padding: var(--space-sm) var(--space-lg); border-radius: var(--radius-sm); text-decoration: none; font-weight: 600; }
  .hero__cta--primary { background: var(--cta); color: var(--on-cta); transition: background-color var(--motion-duration-fast) var(--motion-ease); }
  .hero__cta--primary:hover { background: var(--cta-hover); }
  .hero__cta--secondary { background: var(--white); color: var(--heading); }
</style>
