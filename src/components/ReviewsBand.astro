---
// Floating Google-reviews pill. Grounded in the real V2 export's
// .google-reviews-widget-wrapper-2 (found in services.html): the source
// CSS confirms it's actually `position: fixed` (bottom-left, floating over
// content), not in-flow footer content — the export's markup just happens
// to sit inside footer.html; its own CSS pulls it out visually. Backed by
// the agency's own third-party widget script (fetches from
// vetmarketing.googlewidget.com keyed by a Google Business Profile id) —
// that live widget renders its own already-styled pill, so the hand-built
// pill markup below is only the static fallback shown before a
// googleWidgetId is configured.
//
// Mounted from Footer.astro (2026-09-08 decision) so it's active on every
// page — component-tree home only; CSS position:fixed is what actually
// places it, coordinated with AccessibilityWidget.astro which sits
// immediately to its left at the same bottom offset (real visual ref:
// ref1.jpg). Hidden below MobileCallbar's breakpoint — ref2.jpg's callbar
// closeup has no reviews pill; that screen real-estate goes to the
// callbar's own reserved a11y-widget column instead.
// See Skeleton-Build-Spec.md §6.
import { getSiteInfo } from "../lib/data/site";

// rating/reviewCount props are an override; default source is site.ts so any
// caller (e.g. Footer, mounted site-wide) gets real per-client values with no
// per-page wiring needed.
export interface Props {
  rating?: number;
  reviewCount?: number;
}
const site = await getSiteInfo();
const rating = Astro.props.rating ?? site.googleRating;
const reviewCount = Astro.props.reviewCount ?? site.googleReviewCount;
const stars = "★★★★★";
---

<div class="reviews-band">
  {site.googleWidgetId ? (
    <div class="reviews-band__widget" data-google-widget-id={site.googleWidgetId}>
      <div id="reviews-container"></div>
    </div>
  ) : (
    rating && (
      <a class="reviews-band__pill" href={site.googleReviewsLink || "#"} target="_blank" rel="noopener noreferrer">
        <svg class="reviews-band__g-icon" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
          <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
          <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
          <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
        </svg>
        <span class="reviews-band__rating">{rating.toFixed(1)}</span>
        <span class="reviews-band__stars">{stars}</span>
        {reviewCount && <span class="reviews-band__count">{reviewCount} reviews</span>}
      </a>
    )
  )}
</div>

<style>
  .reviews-band { display: none; }

  @media (min-width: 901px) {
    .reviews-band {
      display: block;
      position: fixed;
      inset-inline-start: var(--reviews-pill-left);
      inset-block-end: 1.5rem;
      z-index: 39; /* just under AccessibilityWidget's own injected button */
    }
  }

  .reviews-band__pill {
    display: flex;
    align-items: center;
    gap: 0.4em;
    box-sizing: border-box;
    height: 50px; /* matches AccessibilityWidget's 50x50 override — see that component */
    background: var(--white);
    color: var(--heading);
    border-radius: 999px;
    padding-inline: 0.9em;
    box-shadow: var(--shadow-float);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .reviews-band__g-icon { inline-size: 28px; block-size: 28px; flex-shrink: 0; }
  .reviews-band__stars { color: var(--star); letter-spacing: -1px; }
  .reviews-band__count { color: var(--main-light); font-weight: 500; text-decoration: underline; }
</style>

<script>
  document.querySelectorAll("[data-google-widget-id]").forEach((widget) => {
    const gmbId = widget.getAttribute("data-google-widget-id");
    const container = widget.querySelector("#reviews-container");
    if (!gmbId || !container) return;
    fetch(`https://vetmarketing.googlewidget.com/api/reviews/${gmbId}`)
      .then((res) => res.text())
      .then((html) => {
        container.innerHTML = html;
      })
      .catch((err) => console.error("Error fetching reviews:", err));
  });
</script>
